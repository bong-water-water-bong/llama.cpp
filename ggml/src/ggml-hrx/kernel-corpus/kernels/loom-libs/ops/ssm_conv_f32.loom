// SSM (Mamba-style) depthwise conv, f32, 2 taps.
// Contract (CONV-CLOSED-FORM.md, agent-ec8072):
//   input  x = [ncs = n_t + 2 rows (2 state rows | token rows)] x [d_inner] channels,
//          contiguous, element (pos, c) at pos + c*ncs.
//   weight w = gguf [2, d_inner], tap-INTERLEAVED per channel: w[tap][c] = file[2c + tap].
//   output y[c][t] = w[0][c]*x[t][c] + w[1][c]*x[t+1][c]  (bias added by a later ADD node)
//   output tensor = [d_inner, n_t] = element (c, t) at c + t*d_inner.
//   prefill: 8 -> 7 rows; decode: 3 -> 2 rows (d_conv = 2).
template.decl @ggml.ssm_conv_f32.apply(%x0: f32, %x1: f32, %w0: f32, %w1: f32) -> (f32)

amdgpu.target<gfx11-generic> @ggml_ssm_conv_f32_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.ssm_conv_f32.token_capacity : %value: index where [range(%value, 1, 2048)]
config.decl @ggml.ssm_conv_f32.d_inner_capacity : %value: index where [range(%value, 1, 262144)]

template.def<@ggml.ssm_conv_f32.apply> device @ggml_ssm_conv_f32_apply(%x0: f32, %x1: f32, %w0: f32, %w1: f32) -> (f32) {
  %p0 = scalar.mul %x0, %w0 : f32
  %p1 = scalar.mul %x1, %w1 : f32
  %y = scalar.add %p0, %p1 : f32
  template.return %y : f32
}

kernel.def target(@ggml_ssm_conv_f32_gfx11_wave64) export("ggml_ssm_conv_f32") @ggml_ssm_conv_f32(%token_count: index, %d_inner: index) {
  %c1 = index.constant 1 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %padded = index.add %d_inner, %c63 : index
  %channel_tiles = index.div %padded, %c64 : index
  kernel.launch.config workgroups(%channel_tiles, %token_count, %c1) workgroup_size(%c64, %c1, %c1) : index
} launch(%token_count: index, %d_inner: index, %input: buffer, %weight: buffer, %output: buffer) {
  %token_capacity = config.get @ggml.ssm_conv_f32.token_capacity : index
  %d_inner_capacity = config.get @ggml.ssm_conv_f32.d_inner_capacity : index
  %bounded_token_count = index.assume %token_count [range(%token_count, 1, 2048), le(%token_count, %token_capacity)] : index
  %bounded_d_inner = index.assume %d_inner [range(%d_inner, 1, 262144), le(%d_inner, %d_inner_capacity)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c64 = index.constant 64 : index
  %c0_offset = index.constant 0 : offset
  %ncs = index.add %bounded_token_count, %c2 : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token = kernel.workgroup.id<y> : index
  %lane = kernel.workitem.id<x> : index
  %tile_base = index.mul %channel_tile, %c64 : index
  %channel0 = index.add %tile_base, %lane : index
  %valid_channel = index.cmp ult, %channel0, %bounded_d_inner : index
  %valid_token = index.cmp ult, %token, %bounded_token_count : index
  %publish = scalar.andi %valid_channel, %valid_token : i1
  %channel = scf.select %valid_channel, %channel0, %c0 : index
  %tok = scf.select %valid_token, %token, %c0 : index
  %input_noalias, %weight_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %output : buffer, buffer, buffer
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%bounded_d_inner]x[%ncs]xf32>
  %weight_view = buffer.view %weight_noalias[%c0_offset] : buffer -> view<[%bounded_d_inner]x[%c2]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%bounded_token_count]x[%bounded_d_inner]xf32>
  scf.if %publish {
    %x0 = view.load %input_view[%channel, %tok] : view<[%bounded_d_inner]x[%ncs]xf32> -> f32
    %tok1 = index.add %tok, %c1 : index
    %x1 = view.load %input_view[%channel, %tok1] : view<[%bounded_d_inner]x[%ncs]xf32> -> f32
    %w0 = view.load %weight_view[%channel, %c0] : view<[%bounded_d_inner]x[%c2]xf32> -> f32
    %w1 = view.load %weight_view[%channel, %c1] : view<[%bounded_d_inner]x[%c2]xf32> -> f32
    %y = template.apply<@ggml.ssm_conv_f32.apply>(%x0, %x1, %w0, %w1) : (f32, f32, f32, f32) -> (f32)
    view.store %y, %output_view[%tok, %channel] : f32, view<[%bounded_token_count]x[%bounded_d_inner]xf32>
  }
  kernel.return
}
