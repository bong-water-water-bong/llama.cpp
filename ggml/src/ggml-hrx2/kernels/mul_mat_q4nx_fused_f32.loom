        %n1 = scf.if %v1 -> (f32) {
          %b1 = view.load %src1_view[%r1] : view<[%src1_count]xf32> -> f32
          %p1 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b1 : f32
          %u1 = scalar.addf<reassoc|nnan|ninf|nsz> %a1, %p1 : f32
