  %dc0_i = index.cast %dc0 : i32 to index
  %d0 = index.assume %dc0_i [range(%dc0_i, 0, %sel_total_m1)] : index
  %dc1 = view.load %dc_view[%c1] : view<[%tbl_count]xi32> -> i32
  %dc1_i = index.cast %dc1 : i32 to index
  %d1 = index.assume %dc1_i [range(%dc1_i, 0, %sel_total_m1)] : index
  %dc2 = view.load %dc_view[%c2] : view<[%tbl_count]xi32> -> i32
  %dc2_i = index.cast %dc2 : i32 to index
  %d2 = index.assume %dc2_i [range(%dc2_i, 0, %sel_total_m1)] : index
  %dc3 = view.load %dc_view[%c3] : view<[%tbl_count]xi32> -> i32
  %dc3_i = index.cast %dc3 : i32 to index
  %d3 = index.assume %dc3_i [range(%dc3_i, 0, %sel_total_m1)] : index
  %dc4 = view.load %dc_view[%c4] : view<[%tbl_count]xi32> -> i32
  %dc4_i = index.cast %dc4 : i32 to index
  %d4 = index.assume %dc4_i [range(%dc4_i, 0, %sel_total_m1)] : index
  %dc5 = view.load %dc_view[%c5] : view<[%tbl_count]xi32> -> i32
  %dc5_i = index.cast %dc5 : i32 to index
  %d5 = index.assume %dc5_i [range(%dc5_i, 0, %sel_total_m1)] : index
  %dc6 = view.load %dc_view[%c6] : view<[%tbl_count]xi32> -> i32
  %dc6_i = index.cast %dc6 : i32 to index
  %d6 = index.assume %dc6_i [range(%dc6_i, 0, %sel_total_m1)] : index
  %dc7 = view.load %dc_view[%c7] : view<[%tbl_count]xi32> -> i32
  %dc7_i = index.cast %dc7 : i32 to index
  %d7 = index.assume %dc7_i [range(%dc7_i, 0, %sel_total_m1)] : index

  %s1b0 = index.mul %t0, %k_bounded : index
  %s1b1 = index.mul %t1, %k_bounded : index
  %s1b2 = index.mul %t2, %k_bounded : index
  %s1b3 = index.mul %t3, %k_bounded : index
  %s1b4 = index.mul %t4, %k_bounded : index
  %s1b5 = index.mul %t5, %k_bounded : index
  %s1b6 = index.mul %t6, %k_bounded : index
  %s1b7 = index.mul %t7, %k_bounded : index
  %db0 = index.mul %d0, %rows_bounded : index
  %db1 = index.mul %d1, %rows_bounded : index
  %db2 = index.mul %d2, %rows_bounded : index
  %db3 = index.mul %d3, %rows_bounded : index
  %db4 = index.mul %d4, %rows_bounded : index
  %db5 = index.mul %d5, %rows_bounded : index
  %db6 = index.mul %d6, %rows_bounded : index
  %db7 = index.mul %d7, %rows_bounded : index

  %k_blocks = index.div %k_bounded, %eight : index
  %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7 =
    scf.for %t = [%kb to %k_blocks step %sixteen](
        %ac0 = %zero_f32, %ac1 = %zero_f32, %ac2 = %zero_f32, %ac3 = %zero_f32,
        %ac4 = %zero_f32, %ac5 = %zero_f32, %ac6 = %zero_f32, %ac7 = %zero_f32 :
        f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    %block_k0 = index.mul %t, %eight : index
    %tile_col = index.div %block_k0, %twofiftysix : index
    %ck_base = index.rem %block_k0, %twofiftysix : index
    %tile_idx = index.mul %tile_row, %n_tc_bounded : index
    %tile_idx2 = index.add %tile_idx, %tile_col : index
    %tile_base = index.mul %tile_idx2, %five120 : index
