config.decl @hrx2.shape.k : %value: index where [range(%value, 1, 65536)]
config.decl @hrx2.shape.rows : %value: index where [range(%value, 1, 262144)]
config.decl @hrx2.shape.cols : %value: index where [range(%value, 1, 512)]
config.decl @hrx2.shape.ntokens : %value: index where [range(%value, 1, 4194304)]
config.decl @hrx2.shape.src1_cols_count : %value: index where [range(%value, 1, 4194304)]
config.decl @hrx2.shape.nselected : %value: index where [range(%value, 1, 64)]
config.decl @hrx2.tuning.q4nx.workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2.tuning.q4nx.n_tile_cols : %value: index where [range(%value, 1, 256)]

// Q4NX fused dequant+matmul (1bit-MONSTER): same math as running
// hrx2_q4nx_dequant_f32 then hrx2_mul_mat_f32_f32_ggml_static, but the
// dequant happens INLINE in the matmul inner loop — the 33.5 MB f32
// dequantized weight (b_w) is never materialized to scratch. Each output
// element (row, col) reads only the raw 5120-byte tiles it needs (5.2 MB
// per expert for rows=4096,k=2048) instead of dequant-writing 33.5 MB and
// mm-reading 33.5 MB back. Decode (cols=1, every group a single token) pays
// that 2x weight traffic per expert per token — this kernel cuts it.
//
// The raw blob layout and dequant index math are copied VERBATIM from
// q4nx_dequant_f32.loom (verified corr 0.9999996053): tile t at byte
// t*5120, scales[0:512] BF16, zeros[512:1024] BF16, packed[1024:5119] int4
// with 8-byte column stride. All divisors (32/256/8/16/2048/5120) are
// JIT-constant, so index.rem/div fold at JIT time exactly as they do in the
// dequant kernel. Per workgroup: one output element, k-reduction over the
// dequantized row.
kernel.def export("hrx2_mul_mat_q4nx_fused_f32") @hrx2_mul_mat_q4nx_fused_f32() {
  %unit = index.constant 1 : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  kernel.launch.config workgroups(%rows, %cols, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %scales: buffer, %zeros: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %unit = index.constant 1 : index
  %two_idx = index.constant 2 : index
  %eight_idx = index.constant 8 : index
  %four_idx = index.constant 4 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %twofiftysix = index.constant 256 : index
  %five120 = index.constant 5120 : index
  %two048 = index.constant 2048 : index
  %two_i32 = scalar.constant 2 : i32
  %four_i32 = scalar.constant 4 : i32
  %eight_i32 = scalar.constant 8 : i32
  %fifteen_i32 = scalar.constant 15 : i32
  %sixteen_i32 = scalar.constant 16 : i32
  %hundred = scalar.constant 100.0 : f32

  %k = config.get @hrx2.shape.k : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %n_tc = config.get @hrx2.tuning.q4nx.n_tile_cols : index
  %k_bounded = index.assume %k [range(%k, 1, 65536)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index
  %n_tc_bounded = index.assume %n_tc [range(%n_tc, 1, 256)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 262143)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 511)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index

  %src1_count = index.mul %k_bounded, %cols_bounded : index
  %dst_count = index.mul %rows_bounded, %cols_bounded : index

  %packed_g = buffer.assume.memory_space<global> %packed : buffer
  %scales_g = buffer.assume.memory_space<global> %scales : buffer
  %zeros_g = buffer.assume.memory_space<global> %zeros : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %packed_a, %scales_a, %zeros_a, %src1_noalias, %dst_noalias =
      buffer.assume.noalias %packed_g, %scales_g, %zeros_g, %src1_global, %dst_global : buffer, buffer, buffer, buffer, buffer
  %packed_v = buffer.view %packed_a[%base] : buffer -> view<1073741824xi8>
  %scales_v = buffer.view %scales_a[%base] : buffer -> view<1073741824xi8>
  %zeros_v = buffer.view %zeros_a[%base] : buffer -> view<1073741824xi8>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32>

  // precompute the row's tile geometry once (row is fixed per workgroup)
  %tile_row = index.div %row, %thirtytwo : index
  %in_tile_row = index.rem %row, %thirtytwo : index
  %tr_x_ntc = index.mul %tile_row, %n_tc_bounded : index
  %in_tile_row8 = index.mul %in_tile_row, %eight_idx : index
  %lane_row = index.rem %in_tile_row, %sixteen : index
  %byte_idx = index.div %lane_row, %two_idx : index
  %nib = index.rem %in_tile_row, %two_idx : index
  %in_tile_lane = index.div %in_tile_row, %sixteen : index
  %lane_base = index.mul %in_tile_lane, %two048 : index
  %nib_i = index.cast %nib : index to i32
  %nib_eq0 = scalar.cmpi eq, %nib_i, %zero_i32 : i32

  %sum = scf.for %i = [%lane to %k_bounded step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    // --- inline dequant of weight (row, i) ---
    %tile_col = index.div %i, %twofiftysix : index
    %in_tile_col = index.rem %i, %twofiftysix : index
    %tile_idx = index.add %tr_x_ntc, %tile_col : index
    %tile_byte_base = index.mul %tile_idx, %five120 : index

    // scale / zero-point (BF16 pairs, row-major within tile)
    %group = index.div %in_tile_col, %thirtytwo : index
    %scale_idx = index.add %in_tile_row8, %group : index
    %scale_off2 = index.mul %scale_idx, %two_idx : index
    %scale_lo_off = index.add %tile_byte_base, %scale_off2 : index
    %scale_hi_off = index.add %scale_lo_off, %unit : index
    %scale_lo = view.load %scales_v[%scale_lo_off] : view<1073741824xi8> -> i8
    %scale_lo_u = scalar.extui %scale_lo : i8 to i32
    %scale_hi = view.load %scales_v[%scale_hi_off] : view<1073741824xi8> -> i8
    %scale_hi_u = scalar.extui %scale_hi : i8 to i32
    %scale_hi_shl = scalar.shli %scale_hi_u, %eight_i32 : i32
    %scale_bf16 = scalar.ori %scale_lo_u, %scale_hi_shl : i32
    %scale_f32_bits = scalar.shli %scale_bf16, %sixteen_i32 : i32
    %scale = scalar.bitcast %scale_f32_bits : i32 to f32

    %zp_lo_off = index.add %tile_byte_base, %scale_off2 : index
    %zp_hi_off = index.add %zp_lo_off, %unit : index
    %zp_lo = view.load %zeros_v[%zp_lo_off] : view<1073741824xi8> -> i8
    %zp_lo_u = scalar.extui %zp_lo : i8 to i32
    %zp_hi = view.load %zeros_v[%zp_hi_off] : view<1073741824xi8> -> i8
    %zp_hi_u = scalar.extui %zp_hi : i8 to i32
    %zp_hi_shl = scalar.shli %zp_hi_u, %eight_i32 : i32
    %zp_bf16 = scalar.ori %zp_lo_u, %zp_hi_shl : i32
    %zp_f32_bits = scalar.shli %zp_bf16, %sixteen_i32 : i32
    %zp = scalar.bitcast %zp_f32_bits : i32 to f32

    %scale_abs = scalar.absf %scale : f32
    %scale_ok = scalar.cmpf olt, %scale_abs, %hundred : f32
    %scale_safe = scf.if %scale_ok -> (f32) {
      scf.yield %scale : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %zp_abs = scalar.absf %zp : f32
    %zp_ok = scalar.cmpf olt, %zp_abs, %hundred : f32
    %zp_safe = scf.if %zp_ok -> (f32) {
      scf.yield %zp : f32
    } else {
      scf.yield %zero_f32 : f32
    }

    %col8 = index.mul %in_tile_col, %eight_idx : index
    %byte_off0 = index.add %lane_base, %col8 : index
    %byte_off1 = index.add %byte_off0, %tile_byte_base : index
    %byte_off2 = index.add %byte_off1, %byte_idx : index
    %packed_byte = view.load %packed_v[%byte_off2] : view<1073741824xi8> -> i8
    %pb_u = scalar.extui %packed_byte : i8 to i32
    %q_low = scalar.andi %pb_u, %fifteen_i32 : i32
    %q_high = scalar.shrui %pb_u, %four_i32 : i32
    %q = scf.if %nib_eq0 -> (i32) {
      scf.yield %q_low : i32
    } else {
      scf.yield %q_high : i32
    }
    %q_lt8 = scalar.cmpi slt, %q, %eight_i32 : i32
    %q_minus_16 = scalar.subi %q, %sixteen_i32 : i32
    %val_i = scf.if %q_lt8 -> (i32) {
      scf.yield %q : i32
    } else {
      scf.yield %q_minus_16 : i32
    }
    %val = scalar.sitofp %val_i : i32 to f32
    %vsc = scalar.mulf %val, %scale_safe : f32
    %a = scalar.addf %vsc, %zp_safe : f32

    // --- matmul ---
    %src1_col_base = index.mul %col, %k_bounded : index
    %src1_off = index.add %i, %src1_col_base : index
    %b = view.load %src1_view[%src1_off] : view<[%src1_count]xf32> -> f32
    %product = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %sum : f32

  %dst_col_base = index.mul %col, %rows_bounded : index
  %dst_index = index.add %row, %dst_col_base : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count]xf32>
  }
  kernel.return
}


// Decode redesign (round 25g): 16 rows per workgroup (one tile lane), 256
// lanes = 16 rows x 16 k-block-split. The packed bytes for the 16 rows at
// one k are 8 CONTIGUOUS bytes (lane*2048 + ck*8 + 0..7), so each k-step
// reads 8-byte coalesced chunks instead of the per-pair kernel's 1-byte
// stride-8 reads. The 16 k-block lanes per row write partial sums to
// workgroup scratch and lane (kb==0) of each row sums them after a barrier.
// rows must be a multiple of 16 (Q4NX rows are always 32-multiples).
kernel.def export("hrx2_mul_mat_q4nx_fused_f32_r16") @hrx2_mul_mat_q4nx_fused_f32_r16() {
  %unit = index.constant 1 : index
  %sixteen = index.constant 16 : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %rows_wg = index.div %rows, %sixteen : index
  kernel.launch.config workgroups(%rows_wg, %cols, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %scales: buffer, %zeros: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %twofiftysix = index.constant 256 : index
  %five120 = index.constant 5120 : index
  %two048 = index.constant 2048 : index
  %scratch_bytes = index.constant 1024 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %two_i32 = scalar.constant 2 : i32
  %four_i32 = scalar.constant 4 : i32
  %eight_i32 = scalar.constant 8 : i32
  %fifteen_i32 = scalar.constant 15 : i32
  %sixteen_i32 = scalar.constant 16 : i32
  %hundred = scalar.constant 100.0 : f32

  %k = config.get @hrx2.shape.k : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %n_tc = config.get @hrx2.tuning.q4nx.n_tile_cols : index
  %k_bounded = index.assume %k [range(%k, 1, 65536)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index
  %n_tc_bounded = index.assume %n_tc [range(%n_tc, 1, 256)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row0_b = index.assume %row0 [range(%row0, 0, 16383)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 511)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %rl = index.rem %lane, %sixteen : index
  %kb = index.div %lane, %sixteen : index
  %base_row0 = index.mul %row0_b, %sixteen : index
  %base_row = index.assume %base_row0 [range(%base_row0, 0, 262143)] : index
  %tile_row = index.div %base_row, %thirtytwo : index
  %in_tile_base = index.rem %base_row, %thirtytwo : index
  %lane_of_tile = index.div %in_tile_base, %sixteen : index
  %abs_in_tile_row0 = index.add %in_tile_base, %rl : index
  %row_in_lane = index.rem %abs_in_tile_row0, %sixteen : index
  %byte_idx = index.div %row_in_lane, %two : index
  %nib = index.rem %row_in_lane, %two : index
  %lane_base = index.mul %lane_of_tile, %two048 : index
  %nib_i = index.cast %nib : index to i32
  %nib_eq0 = scalar.cmpi eq, %nib_i, %zero_i32 : i32
  %kb_i32 = index.cast %kb : index to i32
  %is_kb0 = scalar.cmpi eq, %kb_i32, %zero_i32 : i32

  %src1_count = index.mul %k_bounded, %cols_bounded : index
  %dst_count = index.mul %rows_bounded, %cols_bounded : index

  %packed_g = buffer.assume.memory_space<global> %packed : buffer
  %scales_g = buffer.assume.memory_space<global> %scales : buffer
  %zeros_g = buffer.assume.memory_space<global> %zeros : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %packed_a, %scales_a, %zeros_a, %src1_noalias, %dst_noalias =
      buffer.assume.noalias %packed_g, %scales_g, %zeros_g, %src1_global, %dst_global : buffer, buffer, buffer, buffer, buffer
  %packed_v = buffer.view %packed_a[%base] : buffer -> view<1073741824xi8>
  %scales_v = buffer.view %scales_a[%base] : buffer -> view<1073741824xi8>
  %zeros_v = buffer.view %zeros_a[%base] : buffer -> view<1073741824xi8>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32>

  %scratch = buffer.alloca<workgroup> align(64) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<256xf32>

  %k_blocks = index.div %k_bounded, %eight : index
  %sum = scf.for %t = [%kb to %k_blocks step %sixteen](%acc = %zero_f32 : f32) -> (f32) {
    %block_k0 = index.mul %t, %eight : index
    %tile_col = index.div %block_k0, %twofiftysix : index
    %ck_base = index.rem %block_k0, %twofiftysix : index
    %tile_idx = index.mul %tile_row, %n_tc_bounded : index
    %tile_idx2 = index.add %tile_idx, %tile_col : index
    %tile_base = index.mul %tile_idx2, %five120 : index
    %group = index.div %ck_base, %thirtytwo : index
    %in_tile_row8 = index.mul %abs_in_tile_row0, %eight : index
    %scale_idx = index.add %in_tile_row8, %group : index
    %scale_off2 = index.mul %scale_idx, %two : index
    %scale_lo_off = index.add %tile_base, %scale_off2 : index
    %scale_hi_off = index.add %scale_lo_off, %unit : index
    %scale_lo = view.load %scales_v[%scale_lo_off] : view<1073741824xi8> -> i8
    %scale_lo_u = scalar.extui %scale_lo : i8 to i32
    %scale_hi = view.load %scales_v[%scale_hi_off] : view<1073741824xi8> -> i8
    %scale_hi_u = scalar.extui %scale_hi : i8 to i32
    %scale_hi_shl = scalar.shli %scale_hi_u, %eight_i32 : i32
    %scale_bf16 = scalar.ori %scale_lo_u, %scale_hi_shl : i32
    %scale_f32_bits = scalar.shli %scale_bf16, %sixteen_i32 : i32
    %scale = scalar.bitcast %scale_f32_bits : i32 to f32

    %zp_lo_off = index.add %tile_base, %scale_off2 : index
    %zp_hi_off = index.add %zp_lo_off, %unit : index
    %zp_lo = view.load %zeros_v[%zp_lo_off] : view<1073741824xi8> -> i8
    %zp_lo_u = scalar.extui %zp_lo : i8 to i32
    %zp_hi = view.load %zeros_v[%zp_hi_off] : view<1073741824xi8> -> i8
    %zp_hi_u = scalar.extui %zp_hi : i8 to i32
    %zp_hi_shl = scalar.shli %zp_hi_u, %eight_i32 : i32
    %zp_bf16 = scalar.ori %zp_lo_u, %zp_hi_shl : i32
    %zp_f32_bits = scalar.shli %zp_bf16, %sixteen_i32 : i32
    %zp = scalar.bitcast %zp_f32_bits : i32 to f32

    %scale_abs = scalar.absf %scale : f32
    %scale_ok = scalar.cmpf olt, %scale_abs, %hundred : f32
    %scale_safe = scf.if %scale_ok -> (f32) {
      scf.yield %scale : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %zp_abs = scalar.absf %zp : f32
    %zp_ok = scalar.cmpf olt, %zp_abs, %hundred : f32
    %zp_safe = scf.if %zp_ok -> (f32) {
      scf.yield %zp : f32
    } else {
      scf.yield %zero_f32 : f32
    }

    %acc2 = scf.for %kk = [%zero to %eight step %unit](%acc_in = %acc : f32) -> (f32) {
      %ck = index.add %ck_base, %kk : index
      %byte_off0 = index.mul %ck, %eight : index
      %byte_off1 = index.add %byte_off0, %byte_idx : index
      %byte_off2 = index.add %lane_base, %byte_off1 : index
      %byte_off3 = index.add %byte_off2, %tile_base : index
      %packed_byte = view.load %packed_v[%byte_off3] : view<1073741824xi8> -> i8
      %pb_u = scalar.extui %packed_byte : i8 to i32
      %q_low = scalar.andi %pb_u, %fifteen_i32 : i32
      %q_high = scalar.shrui %pb_u, %four_i32 : i32
      %q = scf.if %nib_eq0 -> (i32) {
        scf.yield %q_low : i32
      } else {
        scf.yield %q_high : i32
      }
      %q_lt8 = scalar.cmpi slt, %q, %eight_i32 : i32
      %q_minus_16 = scalar.subi %q, %sixteen_i32 : i32
      %val_i = scf.if %q_lt8 -> (i32) {
        scf.yield %q : i32
      } else {
        scf.yield %q_minus_16 : i32
      }
      %val = scalar.sitofp %val_i : i32 to f32
      %vsc = scalar.mulf %val, %scale_safe : f32
      %a = scalar.addf %vsc, %zp_safe : f32
      %k_abs = index.add %block_k0, %kk : index
      %src1_off0 = index.mul %k_abs, %cols_bounded : index
      %src1_off = index.add %src1_off0, %col : index
      %b = view.load %src1_view[%src1_off] : view<[%src1_count]xf32> -> f32
      %product = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b : f32
      %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc_in, %product : f32
      scf.yield %next : f32
    }
    scf.yield %acc2 : f32
  }

  %sum_vec = vector.from_elements %sum : vector<1xf32>
  vector.store %sum_vec, %scratch_view[%lane] : vector<1xf32>, view<256xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  scf.if %is_kb0 {
    %s0 = view.load %scratch_view[%rl] : view<256xf32> -> f32
    %rl1 = index.add %rl, %sixteen : index
    %s1 = view.load %scratch_view[%rl1] : view<256xf32> -> f32
    %t1 = scalar.addf %s0, %s1 : f32
    %rl2 = index.add %rl1, %sixteen : index
    %s2 = view.load %scratch_view[%rl2] : view<256xf32> -> f32
    %t2 = scalar.addf %t1, %s2 : f32
    %rl3 = index.add %rl2, %sixteen : index
    %s3 = view.load %scratch_view[%rl3] : view<256xf32> -> f32
    %t3 = scalar.addf %t2, %s3 : f32
    %rl4 = index.add %rl3, %sixteen : index
    %s4 = view.load %scratch_view[%rl4] : view<256xf32> -> f32
    %t4 = scalar.addf %t3, %s4 : f32
    %rl5 = index.add %rl4, %sixteen : index
    %s5 = view.load %scratch_view[%rl5] : view<256xf32> -> f32
    %t5 = scalar.addf %t4, %s5 : f32
    %rl6 = index.add %rl5, %sixteen : index
    %s6 = view.load %scratch_view[%rl6] : view<256xf32> -> f32
    %t6 = scalar.addf %t5, %s6 : f32
    %rl7 = index.add %rl6, %sixteen : index
    %s7 = view.load %scratch_view[%rl7] : view<256xf32> -> f32
    %t7 = scalar.addf %t6, %s7 : f32
    %rl8 = index.add %rl7, %sixteen : index
    %s8 = view.load %scratch_view[%rl8] : view<256xf32> -> f32
    %t8 = scalar.addf %t7, %s8 : f32
    %rl9 = index.add %rl8, %sixteen : index
    %s9 = view.load %scratch_view[%rl9] : view<256xf32> -> f32
    %t9 = scalar.addf %t8, %s9 : f32
    %rl10 = index.add %rl9, %sixteen : index
    %s10 = view.load %scratch_view[%rl10] : view<256xf32> -> f32
    %t10 = scalar.addf %t9, %s10 : f32
    %rl11 = index.add %rl10, %sixteen : index
    %s11 = view.load %scratch_view[%rl11] : view<256xf32> -> f32
    %t11 = scalar.addf %t10, %s11 : f32
    %rl12 = index.add %rl11, %sixteen : index
    %s12 = view.load %scratch_view[%rl12] : view<256xf32> -> f32
    %t12 = scalar.addf %t11, %s12 : f32
    %rl13 = index.add %rl12, %sixteen : index
    %s13 = view.load %scratch_view[%rl13] : view<256xf32> -> f32
    %t13 = scalar.addf %t12, %s13 : f32
    %rl14 = index.add %rl13, %sixteen : index
    %s14 = view.load %scratch_view[%rl14] : view<256xf32> -> f32
    %t14 = scalar.addf %t13, %s14 : f32
    %rl15 = index.add %rl14, %sixteen : index
    %s15 = view.load %scratch_view[%rl15] : view<256xf32> -> f32
    %t15 = scalar.addf %t14, %s15 : f32

    %dst_row = index.add %base_row, %rl : index
    %dst_col_base = index.mul %col, %rows_bounded : index
    %dst_index = index.add %dst_row, %dst_col_base : index
    view.store %t15, %dst_view[%dst_index] : f32, view<[%dst_count]xf32>
  }
  kernel.return
}

// r16x8: 16 rows x 8 cols per workgroup, dense prefill. Adapts the r16
// decode kernel (16 rows/wg, 256 lanes = 16 rows x 16 k-block split, 8-byte
// coalesced packed reads) to process 8 OUTPUT COLUMNS per workgroup: every
// lane accumulates all 8 cols over its k-chunk, so the packed byte stream
// for its row is read once and feeds 8 matmuls. Per-row reduction over the
// 16 kb-lanes via workgroup scratch (phase 2: lanes 0..127, one (row,col)
// each, sum 16 kb-partials). Workgroups = (rows/16, ceil(cols/8)). Dense
// identity col mapping (MoE keeps the table-scatter tbl_tiled kernel).
kernel.def export("hrx2_mul_mat_q4nx_fused_f32_r16x8") @hrx2_mul_mat_q4nx_fused_f32_r16x8() {
  %unit = index.constant 1 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %rows_wg = index.div %rows, %sixteen : index
  %col_groups_round = index.add %cols, %seven : index
  %col_groups = index.div %col_groups_round, %eight : index
  kernel.launch.config workgroups(%rows_wg, %col_groups, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %scales: buffer, %zeros: buffer, %src1: buffer, %dst: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %twofiftysix = index.constant 256 : index
  %five120 = index.constant 5120 : index
  %two048 = index.constant 2048 : index
  %one_two_eight = index.constant 128 : index
  %scratch_bytes = index.constant 8192 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %two_i32 = scalar.constant 2 : i32
  %four_i32 = scalar.constant 4 : i32
  %eight_i32 = scalar.constant 8 : i32
  %fifteen_i32 = scalar.constant 15 : i32
  %sixteen_i32 = scalar.constant 16 : i32
  %hundred = scalar.constant 100.0 : f32

  %k = config.get @hrx2.shape.k : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %n_tc = config.get @hrx2.tuning.q4nx.n_tile_cols : index
  %k_bounded = index.assume %k [range(%k, 1, 65536)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index
  %n_tc_bounded = index.assume %n_tc [range(%n_tc, 1, 256)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row0_b = index.assume %row0 [range(%row0, 0, 16383)] : index
  %cg0 = kernel.workgroup.id<y> : index
  %cg = index.assume %cg0 [range(%cg0, 0, 63)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %rl = index.rem %lane, %sixteen : index
  %kb = index.div %lane, %sixteen : index
  %base_row0 = index.mul %row0_b, %sixteen : index
  %base_row = index.assume %base_row0 [range(%base_row0, 0, 262143)] : index
  %tile_row = index.div %base_row, %thirtytwo : index
  %in_tile_base = index.rem %base_row, %thirtytwo : index
  %lane_of_tile = index.div %in_tile_base, %sixteen : index
  %abs_in_tile_row0 = index.add %in_tile_base, %rl : index
  %row_in_lane = index.rem %abs_in_tile_row0, %sixteen : index
  %byte_idx = index.div %row_in_lane, %two : index
  %nib = index.rem %row_in_lane, %two : index
  %lane_base = index.mul %lane_of_tile, %two048 : index
  %nib_i = index.cast %nib : index to i32
  %nib_eq0 = scalar.cmpi eq, %nib_i, %zero_i32 : i32

  %col_base0 = index.mul %cg, %eight : index
  %col_base = index.assume %col_base0 [range(%col_base0, 0, 511)] : index
  %c0 = index.add %col_base, %zero : index
  %c1 = index.add %col_base, %unit : index
  %c2 = index.add %col_base, %two : index
  %c3 = index.add %c2, %unit : index
  %c4 = index.add %c3, %unit : index
  %c5 = index.add %c4, %unit : index
  %c6 = index.add %c5, %unit : index
  %c7 = index.add %c6, %unit : index
  %v0 = index.cmp ult, %c0, %cols_bounded : index
  %v1 = index.cmp ult, %c1, %cols_bounded : index
  %v2 = index.cmp ult, %c2, %cols_bounded : index
  %v3 = index.cmp ult, %c3, %cols_bounded : index
  %v4 = index.cmp ult, %c4, %cols_bounded : index
  %v5 = index.cmp ult, %c5, %cols_bounded : index
  %v6 = index.cmp ult, %c6, %cols_bounded : index
  %v7 = index.cmp ult, %c7, %cols_bounded : index

  %src1_count = index.mul %k_bounded, %cols_bounded : index
  %dst_count = index.mul %rows_bounded, %cols_bounded : index

  %packed_g = buffer.assume.memory_space<global> %packed : buffer
  %scales_g = buffer.assume.memory_space<global> %scales : buffer
  %zeros_g = buffer.assume.memory_space<global> %zeros : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %packed_a, %scales_a, %zeros_a, %src1_noalias, %dst_noalias =
      buffer.assume.noalias %packed_g, %scales_g, %zeros_g, %src1_global, %dst_global : buffer, buffer, buffer, buffer, buffer
  %packed_v = buffer.view %packed_a[%base] : buffer -> view<1073741824xi8>
  %scales_v = buffer.view %scales_a[%base] : buffer -> view<1073741824xi8>
  %zeros_v = buffer.view %zeros_a[%base] : buffer -> view<1073741824xi8>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32>

  %scratch = buffer.alloca<workgroup> align(64) %scratch_bytes : buffer
  %scratch_view = buffer.view %scratch[%base] : buffer -> view<2048xf32>

  %k_blocks = index.div %k_bounded, %eight : index
  %s0, %s1, %s2, %s3, %s4, %s5, %s6, %s7 =
    scf.for %t = [%kb to %k_blocks step %sixteen](
        %ac0 = %zero_f32, %ac1 = %zero_f32, %ac2 = %zero_f32, %ac3 = %zero_f32,
        %ac4 = %zero_f32, %ac5 = %zero_f32, %ac6 = %zero_f32, %ac7 = %zero_f32 :
        f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
    %block_k0 = index.mul %t, %eight : index
    %tile_col = index.div %block_k0, %twofiftysix : index
    %ck_base = index.rem %block_k0, %twofiftysix : index
    %tile_idx = index.mul %tile_row, %n_tc_bounded : index
    %tile_idx2 = index.add %tile_idx, %tile_col : index
    %tile_base = index.mul %tile_idx2, %five120 : index
    %group = index.div %ck_base, %thirtytwo : index
    %in_tile_row8 = index.mul %abs_in_tile_row0, %eight : index
    %scale_idx = index.add %in_tile_row8, %group : index
    %scale_off2 = index.mul %scale_idx, %two : index
    %scale_lo_off = index.add %tile_base, %scale_off2 : index
    %scale_hi_off = index.add %scale_lo_off, %unit : index
    %scale_lo = view.load %scales_v[%scale_lo_off] : view<1073741824xi8> -> i8
    %scale_lo_u = scalar.extui %scale_lo : i8 to i32
    %scale_hi = view.load %scales_v[%scale_hi_off] : view<1073741824xi8> -> i8
    %scale_hi_u = scalar.extui %scale_hi : i8 to i32
    %scale_hi_shl = scalar.shli %scale_hi_u, %eight_i32 : i32
    %scale_bf16 = scalar.ori %scale_lo_u, %scale_hi_shl : i32
    %scale_f32_bits = scalar.shli %scale_bf16, %sixteen_i32 : i32
    %scale = scalar.bitcast %scale_f32_bits : i32 to f32

    %zp_lo_off = index.add %tile_base, %scale_off2 : index
    %zp_hi_off = index.add %zp_lo_off, %unit : index
    %zp_lo = view.load %zeros_v[%zp_lo_off] : view<1073741824xi8> -> i8
    %zp_lo_u = scalar.extui %zp_lo : i8 to i32
    %zp_hi = view.load %zeros_v[%zp_hi_off] : view<1073741824xi8> -> i8
    %zp_hi_u = scalar.extui %zp_hi : i8 to i32
    %zp_hi_shl = scalar.shli %zp_hi_u, %eight_i32 : i32
    %zp_bf16 = scalar.ori %zp_lo_u, %zp_hi_shl : i32
    %zp_f32_bits = scalar.shli %zp_bf16, %sixteen_i32 : i32
    %zp = scalar.bitcast %zp_f32_bits : i32 to f32

    %scale_abs = scalar.absf %scale : f32
    %scale_ok = scalar.cmpf olt, %scale_abs, %hundred : f32
    %scale_safe = scf.if %scale_ok -> (f32) {
      scf.yield %scale : f32
    } else {
      scf.yield %zero_f32 : f32
    }
    %zp_abs = scalar.absf %zp : f32
    %zp_ok = scalar.cmpf olt, %zp_abs, %hundred : f32
    %zp_safe = scf.if %zp_ok -> (f32) {
      scf.yield %zp : f32
    } else {
      scf.yield %zero_f32 : f32
    }

    %q0, %q1, %q2, %q3, %q4, %q5, %q6, %q7 =
      scf.for %kk = [%zero to %eight step %unit](
          %a0 = %ac0, %a1 = %ac1, %a2 = %ac2, %a3 = %ac3,
          %a4 = %ac4, %a5 = %ac5, %a6 = %ac6, %a7 = %ac7 :
          f32, f32, f32, f32, f32, f32, f32, f32) -> (f32, f32, f32, f32, f32, f32, f32, f32) {
        %ck = index.add %ck_base, %kk : index
        %byte_off0 = index.mul %ck, %eight : index
        %byte_off1 = index.add %byte_off0, %byte_idx : index
        %byte_off2 = index.add %lane_base, %byte_off1 : index
        %byte_off3 = index.add %byte_off2, %tile_base : index
        %packed_byte = view.load %packed_v[%byte_off3] : view<1073741824xi8> -> i8
        %pb_u = scalar.extui %packed_byte : i8 to i32
        %q_low = scalar.andi %pb_u, %fifteen_i32 : i32
        %q_high = scalar.shrui %pb_u, %four_i32 : i32
        %q = scf.if %nib_eq0 -> (i32) {
          scf.yield %q_low : i32
        } else {
          scf.yield %q_high : i32
        }
        %q_lt8 = scalar.cmpi slt, %q, %eight_i32 : i32
        %q_minus_16 = scalar.subi %q, %sixteen_i32 : i32
        %val_i = scf.if %q_lt8 -> (i32) {
          scf.yield %q : i32
        } else {
          scf.yield %q_minus_16 : i32
        }
        %val = scalar.sitofp %val_i : i32 to f32
        %vsc = scalar.mulf %val, %scale_safe : f32
        %a = scalar.addf %vsc, %zp_safe : f32
        %k_abs = index.add %block_k0, %kk : index

        %s1_off0 = index.mul %k_abs, %cols_bounded : index
        %s1_off_0 = index.add %s1_off0, %c0 : index
        %s1_off_1 = index.add %s1_off0, %c1 : index
        %s1_off_2 = index.add %s1_off0, %c2 : index
        %s1_off_3 = index.add %s1_off0, %c3 : index
        %s1_off_4 = index.add %s1_off0, %c4 : index
        %s1_off_5 = index.add %s1_off0, %c5 : index
        %s1_off_6 = index.add %s1_off0, %c6 : index
        %s1_off_7 = index.add %s1_off0, %c7 : index

        %b0 = view.load %src1_view[%s1_off_0] : view<[%src1_count]xf32> -> f32
        %b1 = view.load %src1_view[%s1_off_1] : view<[%src1_count]xf32> -> f32
        %b2 = view.load %src1_view[%s1_off_2] : view<[%src1_count]xf32> -> f32
        %b3 = view.load %src1_view[%s1_off_3] : view<[%src1_count]xf32> -> f32
        %b4 = view.load %src1_view[%s1_off_4] : view<[%src1_count]xf32> -> f32
        %b5 = view.load %src1_view[%s1_off_5] : view<[%src1_count]xf32> -> f32
        %b6 = view.load %src1_view[%s1_off_6] : view<[%src1_count]xf32> -> f32
        %b7 = view.load %src1_view[%s1_off_7] : view<[%src1_count]xf32> -> f32

        %p0 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b0 : f32
        %p1 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b1 : f32
        %p2 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b2 : f32
        %p3 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b3 : f32
        %p4 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b4 : f32
        %p5 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b5 : f32
        %p6 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b6 : f32
        %p7 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b7 : f32
        %n0 = scalar.addf<reassoc|nnan|ninf|nsz> %a0, %p0 : f32
        %n1 = scalar.addf<reassoc|nnan|ninf|nsz> %a1, %p1 : f32
        %n2 = scalar.addf<reassoc|nnan|ninf|nsz> %a2, %p2 : f32
        %n3 = scalar.addf<reassoc|nnan|ninf|nsz> %a3, %p3 : f32
        %n4 = scalar.addf<reassoc|nnan|ninf|nsz> %a4, %p4 : f32
        %n5 = scalar.addf<reassoc|nnan|ninf|nsz> %a5, %p5 : f32
        %n6 = scalar.addf<reassoc|nnan|ninf|nsz> %a6, %p6 : f32
        %n7 = scalar.addf<reassoc|nnan|ninf|nsz> %a7, %p7 : f32
        scf.yield %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 :
            f32, f32, f32, f32, f32, f32, f32, f32
      }
    scf.yield %q0, %q1, %q2, %q3, %q4, %q5, %q6, %q7 :
        f32, f32, f32, f32, f32, f32, f32, f32
  }

  // phase 1: each lane writes its 8 col partials to scratch[lane*8 + col]
  %lane8_0 = index.mul %lane, %eight : index
  %lane8_1 = index.add %lane8_0, %unit : index
  %lane8_2 = index.add %lane8_0, %two : index
  %lane8_3 = index.add %lane8_2, %unit : index
  %lane8_4 = index.add %lane8_3, %unit : index
  %lane8_5 = index.add %lane8_4, %unit : index
  %lane8_6 = index.add %lane8_5, %unit : index
  %lane8_7 = index.add %lane8_6, %unit : index
  %sv0 = vector.from_elements %s0 : vector<1xf32>
  %sv1 = vector.from_elements %s1 : vector<1xf32>
  %sv2 = vector.from_elements %s2 : vector<1xf32>
  %sv3 = vector.from_elements %s3 : vector<1xf32>
  %sv4 = vector.from_elements %s4 : vector<1xf32>
  %sv5 = vector.from_elements %s5 : vector<1xf32>
  %sv6 = vector.from_elements %s6 : vector<1xf32>
  %sv7 = vector.from_elements %s7 : vector<1xf32>
  vector.store %sv0, %scratch_view[%lane8_0] : vector<1xf32>, view<2048xf32>
  vector.store %sv1, %scratch_view[%lane8_1] : vector<1xf32>, view<2048xf32>
  vector.store %sv2, %scratch_view[%lane8_2] : vector<1xf32>, view<2048xf32>
  vector.store %sv3, %scratch_view[%lane8_3] : vector<1xf32>, view<2048xf32>
  vector.store %sv4, %scratch_view[%lane8_4] : vector<1xf32>, view<2048xf32>
  vector.store %sv5, %scratch_view[%lane8_5] : vector<1xf32>, view<2048xf32>
  vector.store %sv6, %scratch_view[%lane8_6] : vector<1xf32>, view<2048xf32>
  vector.store %sv7, %scratch_view[%lane8_7] : vector<1xf32>, view<2048xf32>
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)

  // phase 2: lanes 0..127, one (row, col) each: row = l/8, col = l%8.
  // Sum the 16 kb-partials: scratch[(row*16 + kb)*8 + col] for kb 0..15.
  %l128 = index.rem %lane, %one_two_eight : index
  %row_reduce = index.div %l128, %eight : index
  %col_reduce = index.rem %l128, %eight : index
  %in_phase2 = index.cmp ult, %lane, %one_two_eight : index
  %rsum = scf.if %in_phase2 -> (f32) {
    // phase-1 writers (lane = kb*16 + rl) store row rl's partial at
    // scratch[(kb*16 + rl)*8 + col] — kb is the HIGH component. The reader
    // must sum the same layout: lane_part = kk2*16 + row_reduce (kb high,
    // row low). Using (row_reduce*16 + kk2) transposed the reduction and
    // only the kb==row diagonal (1/16) landed correctly -> wrong logits.
    %sum_all = scf.for %kk2 = [%zero to %sixteen step %unit](%rs = %zero_f32 : f32) -> (f32) {
      %lane_part0 = index.mul %kk2, %sixteen : index
      %lane_part = index.add %lane_part0, %row_reduce : index
      %part8 = index.mul %lane_part, %eight : index
      %part_off = index.add %part8, %col_reduce : index
      %pv = view.load %scratch_view[%part_off] : view<2048xf32> -> f32
      %rnext = scalar.addf<reassoc|nnan|ninf|nsz> %rs, %pv : f32
      scf.yield %rnext : f32
    }
    scf.yield %sum_all : f32
  } else {
    scf.yield %zero_f32 : f32
  }

  // write dst: row = base_row + row_reduce, col = col_base + col_reduce
  %abs_row = index.add %base_row, %row_reduce : index
  %col_abs0 = index.add %col_base, %col_reduce : index
  %col_abs = index.assume %col_abs0 [range(%col_abs0, 0, 511)] : index
  %dst_col_off = index.mul %col_abs, %rows_bounded : index
  %dst_final = index.add %abs_row, %dst_col_off : index
  %valid = index.cmp ult, %col_abs, %cols_bounded : index
  scf.if %in_phase2 {
    scf.if %valid {
      view.store %rsum, %dst_view[%dst_final] : f32, view<[%dst_count]xf32>
    }
  }
  kernel.return
}

// r16x8t: 16 rows x 8 table-scatter cols per workgroup — MoE grouped path.
// Same structure as r16x8 (16 rows/wg, 256 lanes = 16 rows x 16 k-blocks,
// per-row scratch reduction) but the 8 output columns come from i32
// src1_cols/dst_cols tables (identity for dense, per-expert scatter for
// MoE). Every lane loads its row's packed bytes for its k-chunk and
// accumulates the 8 table-selected columns; guarded per-column loads keep
// slots >= cols from touching src1. 7 bindings (packed, scales, zeros,
// src1, dst, src1_cols, dst_cols).
kernel.def export("hrx2_mul_mat_q4nx_fused_f32_r16x8t") @hrx2_mul_mat_q4nx_fused_f32_r16x8t() {
  %unit = index.constant 1 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %rows_wg = index.div %rows, %sixteen : index
  %col_groups_round = index.add %cols, %seven : index
  %col_groups = index.div %col_groups_round, %eight : index
  kernel.launch.config workgroups(%rows_wg, %col_groups, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%packed: buffer, %scales: buffer, %zeros: buffer, %src1: buffer, %dst: buffer, %src1_cols: buffer, %dst_cols: buffer) {
  %base = index.constant 0 : offset
  %zero = index.constant 0 : index
  %unit = index.constant 1 : index
  %two = index.constant 2 : index
  %seven = index.constant 7 : index
  %eight = index.constant 8 : index
  %sixteen = index.constant 16 : index
  %thirtytwo = index.constant 32 : index
  %twofiftysix = index.constant 256 : index
  %five120 = index.constant 5120 : index
  %two048 = index.constant 2048 : index
  %one_two_eight = index.constant 128 : index
  %scratch_bytes = index.constant 8192 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %two_i32 = scalar.constant 2 : i32
  %four_i32 = scalar.constant 4 : i32
  %eight_i32 = scalar.constant 8 : i32
  %fifteen_i32 = scalar.constant 15 : i32
  %sixteen_i32 = scalar.constant 16 : i32
  %hundred = scalar.constant 100.0 : f32

  %k = config.get @hrx2.shape.k : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %ntokens = config.get @hrx2.shape.ntokens : index
  %nselected = config.get @hrx2.shape.nselected : index
  %workgroup_size = config.get @hrx2.tuning.q4nx.workgroup_size : index
  %n_tc = config.get @hrx2.tuning.q4nx.n_tile_cols : index
  %k_bounded = index.assume %k [range(%k, 1, 65536)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 262144)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index
  %n_tc_bounded = index.assume %n_tc [range(%n_tc, 1, 256)] : index
  %ntokens_bounded = index.assume %ntokens [range(%ntokens, 1, 4194304)] : index
  %nselected_bounded = index.assume %nselected [range(%nselected, 1, 64)] : index
  %src1_cols_count = config.get @hrx2.shape.src1_cols_count : index
  %ntokens_m1 = index.sub %ntokens_bounded, %unit : index
  %src1_cols_m1 = index.sub %src1_cols_count, %unit : index
  %sel_total = index.mul %nselected_bounded, %ntokens_bounded : index
  %sel_total_m1 = index.sub %sel_total, %unit : index

  %row0 = kernel.workgroup.id<x> : index
  %row0_b = index.assume %row0 [range(%row0, 0, 16383)] : index
  %cg0 = kernel.workgroup.id<y> : index
  %cg = index.assume %cg0 [range(%cg0, 0, 63)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 255)] : index

  %rl = index.rem %lane, %sixteen : index
  %kb = index.div %lane, %sixteen : index
  %base_row0 = index.mul %row0_b, %sixteen : index
  %base_row = index.assume %base_row0 [range(%base_row0, 0, 262143)] : index
  %tile_row = index.div %base_row, %thirtytwo : index
  %in_tile_base = index.rem %base_row, %thirtytwo : index
  %lane_of_tile = index.div %in_tile_base, %sixteen : index
  %abs_in_tile_row0 = index.add %in_tile_base, %rl : index
  %row_in_lane = index.rem %abs_in_tile_row0, %sixteen : index
  %byte_idx = index.div %row_in_lane, %two : index
  %nib = index.rem %row_in_lane, %two : index
  %lane_base = index.mul %lane_of_tile, %two048 : index
  %nib_i = index.cast %nib : index to i32
  %nib_eq0 = scalar.cmpi eq, %nib_i, %zero_i32 : i32

  %col_base0 = index.mul %cg, %eight : index
  %col_base = index.assume %col_base0 [range(%col_base0, 0, 511)] : index
  %c0 = index.add %col_base, %zero : index
  %c1 = index.add %col_base, %unit : index
  %c2 = index.add %col_base, %two : index
  %c3 = index.add %c2, %unit : index
  %c4 = index.add %c3, %unit : index
  %c5 = index.add %c4, %unit : index
  %c6 = index.add %c5, %unit : index
  %c7 = index.add %c6, %unit : index
  %v0 = index.cmp ult, %c0, %cols_bounded : index
  %v1 = index.cmp ult, %c1, %cols_bounded : index
  %v2 = index.cmp ult, %c2, %cols_bounded : index
  %v3 = index.cmp ult, %c3, %cols_bounded : index
  %v4 = index.cmp ult, %c4, %cols_bounded : index
  %v5 = index.cmp ult, %c5, %cols_bounded : index
  %v6 = index.cmp ult, %c6, %cols_bounded : index
  %v7 = index.cmp ult, %c7, %cols_bounded : index

  %src1_count = index.mul %k_bounded, %src1_cols_count : index
  %dst_count = index.mul %rows_bounded, %sel_total : index
  %seven_b = index.constant 7 : index
  %tbl_round0 = index.add %cols_bounded, %seven_b : index
  %tbl_groups = index.div %tbl_round0, %eight : index
  %tbl_count = index.mul %tbl_groups, %eight : index

  %packed_g = buffer.assume.memory_space<global> %packed : buffer
  %scales_g = buffer.assume.memory_space<global> %scales : buffer
  %zeros_g = buffer.assume.memory_space<global> %zeros : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %s1c_global = buffer.assume.memory_space<global> %src1_cols : buffer
  %dc_global = buffer.assume.memory_space<global> %dst_cols : buffer
  %packed_a, %scales_a, %zeros_a, %src1_noalias, %dst_noalias, %s1c_noalias, %dc_noalias =
      buffer.assume.noalias %packed_g, %scales_g, %zeros_g, %src1_global, %dst_global, %s1c_global, %dc_global : buffer, buffer, buffer, buffer, buffer, buffer, buffer
  %packed_v = buffer.view %packed_a[%base] : buffer -> view<1073741824xi8>
  %scales_v = buffer.view %scales_a[%base] : buffer -> view<1073741824xi8>
  %zeros_v = buffer.view %zeros_a[%base] : buffer -> view<1073741824xi8>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count]xf32>
  %s1c_view = buffer.view %s1c_noalias[%base] : buffer -> view<[%tbl_count]xi32>
  %dc_view = buffer.view %dc_noalias[%base] : buffer -> view<[%tbl_count]xi32>

