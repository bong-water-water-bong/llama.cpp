        %r1 = index.add %s1b1, %k_abs : index
        %r2 = index.add %s1b2, %k_abs : index
        %r3 = index.add %s1b3, %k_abs : index
        %r4 = index.add %s1b4, %k_abs : index
        %r5 = index.add %s1b5, %k_abs : index
        %r6 = index.add %s1b6, %k_abs : index
        %r7 = index.add %s1b7, %k_abs : index

