  %scratch_view = buffer.view %scratch[%base] : buffer -> view<2048xf32>

  // table-derived src1/dst columns for the 8 slots (truthful assume bounds)
  %tc0 = view.load %s1c_view[%c0] : view<[%tbl_count]xi32> -> i32
  %tc0_i = index.cast %tc0 : i32 to index
  %t0 = index.assume %tc0_i [range(%tc0_i, 0, %src1_cols_m1)] : index
  %tc1 = view.load %s1c_view[%c1] : view<[%tbl_count]xi32> -> i32
  %tc1_i = index.cast %tc1 : i32 to index
  %t1 = index.assume %tc1_i [range(%tc1_i, 0, %src1_cols_m1)] : index
  %tc2 = view.load %s1c_view[%c2] : view<[%tbl_count]xi32> -> i32
  %tc2_i = index.cast %tc2 : i32 to index
  %t2 = index.assume %tc2_i [range(%tc2_i, 0, %src1_cols_m1)] : index
  %tc3 = view.load %s1c_view[%c3] : view<[%tbl_count]xi32> -> i32
  %tc3_i = index.cast %tc3 : i32 to index
  %t3 = index.assume %tc3_i [range(%tc3_i, 0, %src1_cols_m1)] : index
  %tc4 = view.load %s1c_view[%c4] : view<[%tbl_count]xi32> -> i32
  %tc4_i = index.cast %tc4 : i32 to index
  %t4 = index.assume %tc4_i [range(%tc4_i, 0, %src1_cols_m1)] : index
  %tc5 = view.load %s1c_view[%c5] : view<[%tbl_count]xi32> -> i32
  %tc5_i = index.cast %tc5 : i32 to index
  %t5 = index.assume %tc5_i [range(%tc5_i, 0, %src1_cols_m1)] : index
  %tc6 = view.load %s1c_view[%c6] : view<[%tbl_count]xi32> -> i32
  %tc6_i = index.cast %tc6 : i32 to index
  %t6 = index.assume %tc6_i [range(%tc6_i, 0, %src1_cols_m1)] : index
  %tc7 = view.load %s1c_view[%c7] : view<[%tbl_count]xi32> -> i32
  %tc7_i = index.cast %tc7 : i32 to index
  %t7 = index.assume %tc7_i [range(%tc7_i, 0, %src1_cols_m1)] : index

