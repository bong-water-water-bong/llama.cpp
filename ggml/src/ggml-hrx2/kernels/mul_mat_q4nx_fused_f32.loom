          %p7 = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b7 : f32
          %u7 = scalar.addf<reassoc|nnan|ninf|nsz> %a7, %p7 : f32
          scf.yield %u7 : f32
        } else {
          scf.yield %a7 : f32
        }
        scf.yield %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7 :
