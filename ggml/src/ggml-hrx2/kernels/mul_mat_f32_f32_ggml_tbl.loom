config.decl @hrx2.shape.k : %value: index where [range(%value, 1, 8192)]
config.decl @hrx2.shape.rows : %value: index where [range(%value, 1, 8192)]
config.decl @hrx2.shape.cols : %value: index where [range(%value, 1, 512)]
config.decl @hrx2.shape.src1_count : %value: index where [range(%value, 1, 4194304)]
config.decl @hrx2.shape.dst_count : %value: index where [range(%value, 1, 4194304)]
config.decl @hrx2.tuning.workgroup_size : %value: index where [range(%value, 32, 1024), mul(%value, 32)]
config.decl @hrx2.shape.use_col_tables : %value: index where [range(%value, 0, 1)]

// ggml-layout f32 matmul with optional per-column source/destination offset
// tables (1bit-MONSTER MoE grouping). Same math as hrx2_mul_mat_f32_f32_ggml
// (src1 [k, cols] ggml col-major, dst [rows, cols] ggml col-major) but when
// use_col_tables == 1, column c of this slice reads src1 column src1_cols[c]
// and writes dst column dst_cols[c] — letting one slice scatter across the
// MUL_MAT_ID result for a group of tokens that selected the same expert
// (dequantize the expert once per batch instead of once per token).
kernel.def export("hrx2_mul_mat_f32_f32_ggml_tbl_static") @hrx2_mul_mat_f32_f32_ggml_tbl_static() {
  %unit = index.constant 1 : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.workgroup_size : index
  kernel.launch.config workgroups(%rows, %cols, %unit) workgroup_size(%workgroup_size, %unit, %unit) : index
} launch(%src0: buffer, %src1: buffer, %dst: buffer, %src1_cols: buffer, %dst_cols: buffer) {
  %base = index.constant 0 : offset
  %zero_f32 = scalar.constant 0.0 : f32
  %zero_i32 = scalar.constant 0 : i32
  %unit = index.constant 1 : index

  %k = config.get @hrx2.shape.k : index
  %rows = config.get @hrx2.shape.rows : index
  %cols = config.get @hrx2.shape.cols : index
  %workgroup_size = config.get @hrx2.tuning.workgroup_size : index
  %use_tbl = config.get @hrx2.shape.use_col_tables : index
  %k_bounded = index.assume %k [range(%k, 1, 8192)] : index
  %rows_bounded = index.assume %rows [range(%rows, 1, 8192)] : index
  %cols_bounded = index.assume %cols [range(%cols, 1, 512)] : index

  %row0 = kernel.workgroup.id<x> : index
  %row = index.assume %row0 [range(%row0, 0, 8191)] : index
  %col0 = kernel.workgroup.id<y> : index
  %col = index.assume %col0 [range(%col0, 0, 511)] : index
  %lane0 = kernel.workitem.id<x> : index
  %lane = index.assume %lane0 [range(%lane0, 0, 1023)] : index

  %src0_count = index.mul %rows_bounded, %k_bounded : index
  %src1_count = config.get @hrx2.shape.src1_count : index
  %dst_count = config.get @hrx2.shape.dst_count : index
  %src1_count_bounded = index.assume %src1_count [range(%src1_count, 1, 4194304)] : index
  %dst_count_bounded = index.assume %dst_count [range(%dst_count, 1, 4194304)] : index

  %src0_global = buffer.assume.memory_space<global> %src0 : buffer
  %src1_global = buffer.assume.memory_space<global> %src1 : buffer
  %dst_global = buffer.assume.memory_space<global> %dst : buffer
  %s1c_global = buffer.assume.memory_space<global> %src1_cols : buffer
  %dc_global = buffer.assume.memory_space<global> %dst_cols : buffer
  %src0_noalias, %src1_noalias, %dst_noalias, %s1c_noalias, %dc_noalias =
      buffer.assume.noalias %src0_global, %src1_global, %dst_global, %s1c_global, %dc_global : buffer, buffer, buffer, buffer, buffer
  %src0_view = buffer.view %src0_noalias[%base] : buffer -> view<[%src0_count]xf32>
  %src1_view = buffer.view %src1_noalias[%base] : buffer -> view<[%src1_count_bounded]xf32>
  %dst_view = buffer.view %dst_noalias[%base] : buffer -> view<[%dst_count_bounded]xf32>
  %s1c_view = buffer.view %s1c_noalias[%base] : buffer -> view<[%cols_bounded]xi32>
  %dc_view = buffer.view %dc_noalias[%base] : buffer -> view<[%cols_bounded]xi32>

  // effective src1/dst column for this workgroup
  %use_tbl1 = index.cmp ne, %use_tbl, %unit : index   // 1 when tables are used
  %tbl_col = view.load %s1c_view[%col] : view<[%cols_bounded]xi32> -> i32
  %tbl_col_idx = index.cast %tbl_col : i32 to index
  %s1_col = scf.if %use_tbl1 -> (index) {
    scf.yield %tbl_col_idx : index
  } else {
    scf.yield %col : index
  }
  %dtbl_col = view.load %dc_view[%col] : view<[%cols_bounded]xi32> -> i32
  %dtbl_col_idx = index.cast %dtbl_col : i32 to index
  %d_col = scf.if %use_tbl1 -> (index) {
    scf.yield %dtbl_col_idx : index
  } else {
    scf.yield %col : index
  }

  %src0_row_base = index.mul %row, %k_bounded : index
  %sum = scf.for %i = [%lane to %k_bounded step %workgroup_size](%acc = %zero_f32 : f32) -> (f32) {
    %src0_index = index.add %src0_row_base, %i : index
    %src1_col_base = index.mul %s1_col, %k_bounded : index
    %src1_off = index.add %i, %src1_col_base : index
    %a = view.load %src0_view[%src0_index] : view<[%src0_count]xf32> -> f32
    %b = view.load %src1_view[%src1_off] : view<[%src1_count_bounded]xf32> -> f32
    %product = scalar.mulf<reassoc|nnan|ninf|nsz> %a, %b : f32
    %next = scalar.addf<reassoc|nnan|ninf|nsz> %acc, %product : f32
    scf.yield %next : f32
  }
  %dot = kernel.workgroup.reduce<addf> %sum : f32

  %dst_col_base = index.mul %d_col, %rows_bounded : index
  %dst_index = index.add %row, %dst_col_base : index
  %lane_i32 = index.cast %lane : index to i32
  %is_lane0 = scalar.cmpi eq, %lane_i32, %zero_i32 : i32
  scf.if %is_lane0 {
    view.store %dot, %dst_view[%dst_index] : f32, view<[%dst_count_bounded]xf32>
  }
  kernel.return
}
